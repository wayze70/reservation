@using Microsoft.AspNetCore.Components.Authorization
@inject IAuthService AuthService
@inject NavigationManager NavigationManager

<nav>
    <AuthorizeView>
        <Authorized>
            <a href="@Constants.Routes.Account" class="text-white me-3">Účet</a>
            <a href="@Constants.Routes.Reservation" class="text-white me-3">Kalendář</a>
            <a @onclick="@Logout" class="text-white me-3">Odlásit se</a>
        </Authorized>
        <NotAuthorized>
            <a href="@Constants.Routes.Login" class="text-white">Přihlášení</a>
            <a href="@Constants.Routes.Register" class="text-white">Registrace</a>
        </NotAuthorized>
    </AuthorizeView>
</nav>

@code {
    void Logout()
    {
        AuthService.LogoutAsync();
        NavigationManager.NavigateTo(Constants.Routes.Login);
    }
}
@page "/rezervace/{Path}/{Id:int}"
@inject IReservationService ReservationService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<PageTitle>Detail rezervace</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mx-auto my-6">
    @if (ReservationDetail is null)
    {
        <MudText>Načítám rezervaci...</MudText>
    }
    else
    {
        <MudCard>
            <MudCardActions>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="Back">
                    Zpět na rezervace
                </MudButton>
            </MudCardActions>
            <MudCardHeader>
                <MudText Typo="Typo.h5">@ReservationDetail.Title</MudText>
            </MudCardHeader>
            <MudCardContent>
                <MudText>Popis: @ReservationDetail.Description</MudText>
                <MudText>
                    Od: @ReservationDetail.Start.ToString("g")
                    @(ReservationDetail.TimeDisplayMode switch
                    {
                        TimeDisplayMode.Utc => $" (Ve vašem lokálním čase: {ReservationDetail.Start.ToLocalTime():t})",
                        TimeDisplayMode.Local => " (Jedná se o lokální čas)",
                        TimeDisplayMode.Custom => " (V časovém pásmu " + DisplayOffset(new TimeSpan(0, ReservationDetail
                            .CustomTimeZone ?? 0,0)) + ")",
                        null => "",
                        _ => throw new ArgumentOutOfRangeException()
                    })
                </MudText>
                <MudText>Do: @ReservationDetail.End.ToString("g")</MudText>
                <MudText>Kapacita: @ReservationDetail.CurrentCapacity / @ReservationDetail.Capacity</MudText>
                <MudText Color="@(ReservationDetail.IsAvailable ? Color.Success : Color.Error)">
                    @(ReservationDetail.IsAvailable ? "Dostupná" : "Nedostupná")
                </MudText>
                <MudDivider Class="my-2"/>
                <MudText>Možnost zrušení před zahájením: @ReservationDetail.CancellationOffset.ToString()</MudText>
                @if (ReservationDetail.TimeDisplayMode.HasValue)
                {
                    <MudText>Režim zobrazení času: @ReservationDetail.TimeDisplayMode</MudText>
                    @if (ReservationDetail.TimeDisplayMode == TimeDisplayMode.Custom && ReservationDetail.CustomTimeZone.HasValue)
                    {
                        <MudText>Vlastní časová zóna: @DisplayOffset(new TimeSpan(0, ReservationDetail
                            .CustomTimeZone ?? 0,0))</MudText>
                    }
                }
            </MudCardContent>
            <MudCardActions>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SignUp">
                    Přihlásit se na rezervaci
                </MudButton>
            </MudCardActions>

        </MudCard>
    }
</MudContainer>

@code {
    [Parameter]
    public string Path { get; set; } = string.Empty;
    [Parameter]
    public int Id { get; set; }

    ReservationResponse? ReservationDetail { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var response = await ReservationService.GetReservationAsync(Path, Id);
        if (response is { IsSuccess: true, Data: not null })
        {
            ReservationDetail = response.Data;
        }
        else
        {
            Snackbar.Add("Nepodařilo se načíst detail rezervace.", Severity.Error);
        }
    }

    private void Back()
    {
        NavigationManager.NavigateTo($"/rezervace/{Path}");
    }

    private void SignUp()
    {
        NavigationManager.NavigateTo($"/rezervace/{Path}/{Id}/prihlaseni");
    }
    
    private string DisplayOffset(TimeSpan offset)
    {
        string sign = offset >= TimeSpan.Zero ? "+" : "-";
        var absOffset = offset.Duration();
        return $"UTC{sign}{absOffset:hh\\:mm}";
    }
}

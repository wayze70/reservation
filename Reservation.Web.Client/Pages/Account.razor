@inject NavigationManager NavigationManager
@inject IAccountService AccountService
@inject IAuthService AuthService
@inject IEmployeeService EmployeeService
@using Microsoft.AspNetCore.Authorization
@using Reservation.Shared.Authorization
@using Reservation.Shared.Common
@inject ISnackbar Snackbar

@page "/ucet"
@attribute [Authorize]

<PageTitle>Účet</PageTitle>
<MudExpansionPanels>
    <MudExpansionPanel Text="Identifikátor" Expanded="true">
        <MudText Typo="Typo.h5" Align="Align.Center" GutterBottom="true">
            Nastavení identifikátoru
        </MudText>

        @if (string.IsNullOrWhiteSpace(CurrentPath))
        {
            <MudText>
                Zadejte unikátní identifikátor, který bude součástí URL vaší rezervace.
                Může to být například vaše jméno, název firmy nebo jiný stručný název, podle kterého si rezervaci snadno zapamatujete.
            </MudText>
        }
        else
        {
            <MudText>
                Aktuální adresa vaší rezervace:
            </MudText>
            <MudText>
                <MudLink Href="@Constants.Routes.Reservation(CurrentPath)" Style="word-wrap: break-word; word-break: break-all;">
                    @(NavigationManager.BaseUri)@Constants.Routes.Reservation(CurrentPath).Remove(0, 1)
                </MudLink>
            </MudText>
        }

        <MudStack Spacing="2" Class="mt-4">
            <MudTextField T="string" Disabled="@(CurrentPath is null)" Value="Path" ValueChanged="OnPathChange"
                          Label="Identifikátor" DebounceInterval="500"/>

            <MudStack Row="false" AlignItems="AlignItems.Center" Spacing="1">
                @if ((IsPathTaken && CurrentPath != Path) || !IsPathValid)
                {
                    <MudIcon Icon="@Icons.Material.Filled.Close" Color="Color.Error" Size="Size.Small"/>
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircleOutline" Color="Color.Success" Size="Size.Small"/>
                }

                @if (IsPathTaken && CurrentPath == Path)
                {
                    <MudText Color="Color.Info">Toto je vaše aktuální adresa</MudText>
                }
                else if (IsPathTaken)
                {
                    <MudText Color="Color.Error">Tato adresa je již obsazená</MudText>
                }
                else if (!IsPathValid)
                {
                    <MudText Color="Color.Error">Adresa obsahuje nepovolené znaky</MudText>
                }
            </MudStack>

            <MudButton OnClick="UpdatePath" Color="Color.Primary" Variant="Variant.Filled" ButtonType="ButtonType.Button" Style="width: fit-content !important;">
                Uložit identifikátor
            </MudButton>
        </MudStack>
    </MudExpansionPanel>
    <MudExpansionPanel Text="Informace o účtu">
        <EditForm Model="_accountInfo" OnValidSubmit="OnAccountInfoValidSubmit"
                  OnInvalidSubmit="OnAccountInfoInvalidSubmit">
            <MudText Typo="Typo.h5" Align="Align.Center" GutterBottom="true">
                Informací o účtu
            </MudText>

            <MudTextField T="string" Label="Organizace" @bind-Value="_accountInfo.Organization"
                          Required="true"/>
            <MudTextField T="string" Label="Popis" @bind-Value="_accountInfo.Description"/>

            <MudButton ButtonType="ButtonType.Submit" Color="Color.Primary" Variant="Variant.Filled" Class="mt-4">
                Uložit informace o účtu
            </MudButton>
        </EditForm>
    </MudExpansionPanel>
    <MudExpansionPanel Text="Osobní údaje o přihlášeném uživateli">
        <EditForm Model="SelectedEmployee" OnValidSubmit="OnAccountInfoValidSubmit"
                  OnInvalidSubmit="OnAccountInfoInvalidSubmit">

            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudTextField T="string" Label="Jméno" @bind-Value="SelectedEmployee.FirstName" Required="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField T="string" Label="Příjmení" @bind-Value="SelectedEmployee.LastName" Required="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField T="string" Label="Email" @bind-Value="SelectedEmployee.Email" Required="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="Role" Label="Pozice" @bind-Value="SelectedEmployee.Role" Required="true">
                        @foreach (Role role in Enum.GetValues(typeof(Role)))
                        {
                            <MudSelectItem Value="@role">@role.ToString()</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            </MudGrid>
            <MudButton ButtonType="ButtonType.Submit" Color="Color.Primary" Variant="Variant.Filled"
                       Class="mt-4">
                Uložit osobní údaje
            </MudButton>
        </EditForm>
    </MudExpansionPanel>

    <MudExpansionPanel Text="Změna hesla přihlášeného uživatele">
            <EditForm Model="_updatePasswordRequest" OnValidSubmit="OnPasswordValidSubmit"
                      OnInvalidSubmit="OnPasswordInvalidSubmit">
                <MudTextField T="string" Label="Staré heslo" @bind-Value="_updatePasswordRequest.OldPassword"
                              Required="true"
                              InputType="InputType.Password"/>
                <MudTextField T="string" Label="Nové heslo" @bind-Value="_updatePasswordRequest.NewPassword"
                              Required="true"
                              InputType="InputType.Password"/>

                <MudButton ButtonType="ButtonType.Submit" Color="Color.Primary" Variant="Variant.Filled"
                           Class="mt-4">
                    Změnit heslo
                </MudButton>
            </EditForm>
    </MudExpansionPanel>

    <MudButton ButtonType="ButtonType.Button" OnClick="() => { AuthService.LogoutAllDevicesAsync();}"
               Color="Color.Warning" Variant="Variant.Filled" Class="mt-4">
        Odhlásit se ze všech zařízení
    </MudButton>

    <MudExpansionPanel Text="Zrušení účtu" Class="mt-5">
            <EditForm Model="_deleteAccountRequest" OnValidSubmit="OnDeleteAccountValidSubmit"
                      OnInvalidSubmit="OnDeleteAccountInvalidSubmit">
                <MudTextField T="string" Label="Email" @bind-Value="_deleteAccountRequest.Email" Required="true"
                              InputType="InputType.Email"/>
                <MudTextField T="string" Label="Heslo" @bind-Value="_deleteAccountRequest.Password" Required="true"
                              InputType="InputType.Password"/>

                <MudButton ButtonType="ButtonType.Submit" Color="Color.Error" Variant="Variant.Filled" Class="mt-4">
                    Smazat účet
                </MudButton>
            </EditForm>
    </MudExpansionPanel>
</MudExpansionPanels>

@code
{
    string Path { get; set; } = "Načítám...";
    string? CurrentPath { get; set; } = null;
    bool IsPathTaken { get; set; }
    bool IsPathValid { get; set; } = true;

    private EmployeeResponse SelectedEmployee = new EmployeeResponse();
    
    private AccountInfoResponse _accountInfo = new();
    private UpdatePasswordRequest _updatePasswordRequest = new();
    private DeleteAccountRequest _deleteAccountRequest = new();

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        CurrentPath = (await AccountService.GetPath()).Data;
        if (CurrentPath is not null)
        {
            Path = CurrentPath;
        }

        var employeesResult = await EmployeeService.GetCurrentEmployee();
        
        if (employeesResult is { IsSuccess: true, Data: not null })
        {
            SelectedEmployee = employeesResult.Data;
        }
        else
        {
            Snackbar.Add("Nepodařilo se načíst údaje o zaměstnanci.", Severity.Error);
        }

        var accountInfoResult = await AccountService.GetAccountInfo();
        if (accountInfoResult is { IsSuccess: true, Data: not null })
        {
            _accountInfo = accountInfoResult.Data;
        }
        else
        {
            Snackbar.Add("Nepodařilo se načíst údaje o účtu.", Severity.Error);
        }
    }

    private async Task UpdatePath()
    {
        if (Utils.IsPathValidate(Path))
        {
            IsPathValid = true;
        }
        else
        {
            IsPathValid = false;
            return;
        }

        var response = await AccountService.UpdatePath(new PathRequest() { Path = Path });

        if (response is { IsSuccess: true, Data: not null })
        {
            CurrentPath = response.Data;

            Snackbar.Add("URL cesta byla úspěšně aktualizována.", Severity.Success);
        }
    }

    private async Task OnPathChange(string newPath)
    {
        Path = newPath;

        if (string.IsNullOrWhiteSpace(Path))
        {
            return;
        }

        if (Utils.IsPathValidate(Path))
        {
            IsPathValid = true;
            IsPathTaken = (await AccountService.IsPathTaken(new PathRequest() { Path = Path })).Data;
        }
        else
        {
            IsPathValid = false;
        }
    }

    private async Task OnAccountInfoValidSubmit()
    {
        var updateRequest = new UpdateAccountInfoRequest
        {
            Organization = _accountInfo.Organization,
            Description = _accountInfo.Description,
        };

        var result = await AccountService.UpdateAccountInfo(updateRequest);
        if (result.IsSuccess)
        {
            Snackbar.Add("Údaje o účtu byly úspěšně aktualizovány.", Severity.Success);
        }
        else
        {
            Snackbar.Add("Chyba při aktualizaci údajů o účtu.", Severity.Error);
        }
    }

    private void OnAccountInfoInvalidSubmit()
    {
        Snackbar.Add("Zkontrolujte, prosím, že jste vyplnili všechna povinná pole.", Severity.Warning);
    }

    private async Task OnPasswordValidSubmit()
    {
        var result = await AccountService.UpdatePassword(_updatePasswordRequest);
        if (result.IsSuccess)
        {
            Snackbar.Add("Heslo bylo úspěšně změněno.", Severity.Success);
            _updatePasswordRequest = new UpdatePasswordRequest();
        }
        else
        {
            Snackbar.Add("Chyba při změně hesla.", Severity.Error);
        }
    }

    private void OnPasswordInvalidSubmit()
    {
        Snackbar.Add("Vyplňte prosím obě pole pro změnu hesla.", Severity.Warning);
    }

    private async Task OnDeleteAccountValidSubmit()
    {
        var result = await AccountService.DeleteAccount(_deleteAccountRequest);
        if (result.IsSuccess)
        {
            Snackbar.Add("Účet byl úspěšně zrušen.", Severity.Success);
            NavigationManager.NavigateTo("/", true);
        }
        else
        {
            Snackbar.Add("Chyba při zrušení účtu.", Severity.Error);
        }
    }

    private void OnDeleteAccountInvalidSubmit()
    {
        Snackbar.Add("Vyplňte prosím obě pole pro zrušení účtu.", Severity.Warning);
    }
}
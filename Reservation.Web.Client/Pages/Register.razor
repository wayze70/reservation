@inject IAuthService AuthService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@using System.Net

@page "/registrace"

<PageTitle>Registrace</PageTitle>

<MudPaper Class="mx-auto my-10 pa-6" MaxWidth="500px">
    <MudText Typo="Typo.h5" Align="Align.Center" GutterBottom="true">
        Registrace
    </MudText>
    <EditForm Model="@RegistrationUser" OnValidSubmit="@OnSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <MudTextField T="string" Label="Jméno" @bind-Value="RegistrationUser.FirstName" Required="true" />
        <MudTextField T="string" Label="Příjmení" @bind-Value="RegistrationUser.LastName" Required="true" />
        <MudTextField T="string" Label="Email" @bind-Value="RegistrationUser.Email" Required="true" />
        <MudTextField T="string" Label="Heslo" InputType="InputType.Password" @bind-Value="RegistrationUser.Password" Required="true" />

        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="mt-4">
            Zaregistrovat se
        </MudButton>

        <MudText Align="Align.Center" Class="mt-4">
            Už máte účet? <MudLink Href="@Constants.Routes.Login">Přihlašte se</MudLink>
        </MudText>
    </EditForm>
</MudPaper>

@code {
    // Zde použijte správný model pro registraci, např. RegistrationRequest
    RegistrationRequest RegistrationUser { get; set; } = new();

    async Task OnSubmit()
    {
        var response = await AuthService.RegisterAsync(RegistrationUser);

        switch (response)
        {
            case HttpStatusCode.OK:
                Snackbar.Add("Registrace proběhla úspěšně", Severity.Success);
                NavigationManager.NavigateTo(Constants.Routes.AccountRoute.Account);
                break;
            case HttpStatusCode.Conflict:
                Snackbar.Add("Uživatel s tímto emailem již existuje", Severity.Error);
                break;
            case HttpStatusCode.BadRequest:
                Snackbar.Add("Heslo musí být alespoň 6 znaků dlouhé", Severity.Error);
                break;
            default:
                Snackbar.Add("Registrace se nezdařila", Severity.Error);
                break;
        }
    }
}

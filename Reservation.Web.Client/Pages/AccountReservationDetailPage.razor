@page "/ucet/rezervace/{reservationId:int}"
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@inject IReservationService ReservationService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<PageTitle>Detail rezervace pro administrátora</PageTitle>
@attribute [Authorize]

    @if (ReservationDetail is null)
    {
        <MudText>Načítám detail rezervace...</MudText>
    }
    else
    {
        <!-- Editační formulář rezervace -->
        <MudPaper Class="pa-6 mb-6" Elevation="4">
            <MudText Typo="Typo.h4" Align="Align.Center" GutterBottom="true">
                Detail rezervace
            </MudText>
            <EditForm Model="@ReservationDetail" OnValidSubmit="@SaveChanges">
                <DataAnnotationsValidator />
                <MudGrid>
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="Nadpis" @bind-Value="ReservationDetail.Title" Required="true" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="Popis" @bind-Value="ReservationDetail.Description" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudNumericField T="int" Label="Maximální kapacita" Min="0" @bind-Value="ReservationDetail.Capacity" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudDatePicker Label="Datum začátku" @bind-Date="Date" Required="true" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTimePicker Label="Začátek rezervace" @bind-Time="StartTime" Required="true" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTimePicker Label="Konec rezervace" @bind-Time="EndTime" Required="true" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudText Typo="Typo.subtitle2">Čas pro zrušení rezervace</MudText>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudNumericField T="int" Min="0" Label="Dny" @bind-Value="CancellationOffsetDays" />
                            <MudTimePicker AmPm="@(!CultureInfo.CurrentCulture.Is24Hrs())" Label="Hodiny" @bind-Time="CancellationOffsetTime" />
                            <MudTooltip Text="Určete kolik dní a hodin před začátkem rezervace má uživatel možnost ji zrušit.">
                                <MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Primary" />
                            </MudTooltip>
                        </MudStack>
                    </MudItem>
                    <MudItem xs="12" sm="6" Class="mt-auto">
                        <MudSelect T="string" Label="Časové pásmo" @bind-Value="ReservationDetail.CustomTimeZoneId" Required="true">
                            @foreach (var timezone in Constants.TimeZones)
                            {
                                <MudSelectItem Value="@timezone.Id">
                                    @timezone.DisplayName
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudSwitch T="bool" Color="Color.Primary" Label="@(ReservationDetail.IsAvailable ? "Aktivní" : "Nekativní")"
                         @bind-Value="ReservationDetail.IsAvailable" />
                    </MudItem>
                </MudGrid>
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" FullWidth="true">
                    Uložit změny
                </MudButton>
            </EditForm>
        </MudPaper>

        <!-- Seznam přihlášených uživatelů -->
        <MudPaper Class="pa-6" Elevation="4">
            <MudText Typo="Typo.h5" GutterBottom="true">
                Přihlášené uživatelé
            </MudText>
            @if (ReservationDetail.Users is null || ReservationDetail.Users.Count == 0)
            {
                <MudText>Nebyli nalezeni žádní uživatelé.</MudText>
            }
            else
            {
                <MudTable Items="ReservationDetail.Users">
                    <HeaderContent>
                        <MudTh>Jméno</MudTh>
                        <MudTh>Příjmení</MudTh>
                        <MudTh>Email</MudTh>
                        <MudTh>Poznámka</MudTh>
                        <MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Jméno">@context.FirstName</MudTd>
                        <MudTd DataLabel="Příjmení">@context.LastName</MudTd>
                        <MudTd DataLabel="Email">@context.Email</MudTd>
                        <MudTd DataLabel="Poznámka">@context.Note</MudTd>
                        <MudTd DataLabel="">
                            <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" OnClick="@(() => RemoveUser(@context))">
                                Odhlásit uživatele
                            </MudButton>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudPaper>
    }

@code {

    [Parameter]
    public int reservationId { get; set; }

    DateTime? Date { get; set; }
    DateTime? DateEnd { get; set; }
    TimeSpan? StartTime { get; set; }
    TimeSpan? EndTime { get; set; }
    int CancellationOffsetDays = 0;
    TimeSpan? CancellationOffsetTime = TimeSpan.Zero;

    ReservationResponseWithUser? ReservationDetail { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var response = await ReservationService.GetReservationWithUserAsync(reservationId);
        if (response is { IsSuccess: true, Data: not null })
        {
            ReservationDetail = response.Data;

            Date = ReservationDetail.Start.ConvertToTimeZone(ReservationDetail.CustomTimeZoneId);
            DateEnd = ReservationDetail.End.ConvertToTimeZone(ReservationDetail.CustomTimeZoneId);
            StartTime = ReservationDetail.Start.ConvertToTimeZone(ReservationDetail.CustomTimeZoneId).TimeOfDay;
            EndTime = ReservationDetail.End.ConvertToTimeZone(ReservationDetail.CustomTimeZoneId).TimeOfDay;
            CancellationOffsetDays = ReservationDetail.CancellationOffset.Days;
            CancellationOffsetTime = ReservationDetail.CancellationOffset - TimeSpan.FromDays(CancellationOffsetDays);
        }
        else
        {
            Snackbar.Add("Nepodařilo se načíst detail rezervace.", Severity.Error);
        }
    }

    private async Task SaveChanges()
    {
        var customTimeZone = TimeZoneInfo.FindSystemTimeZoneById(ReservationDetail.CustomTimeZoneId);
        
        var startLocal = Date.Value.Date.Add(StartTime.Value);
        var endLocal = Date.Value.Date.Add(EndTime.Value);
    
        if (endLocal <= startLocal)
        {
            endLocal = endLocal.AddDays(1);
        }

        startLocal = DateTime.SpecifyKind(startLocal, DateTimeKind.Unspecified);
        endLocal = DateTime.SpecifyKind(endLocal, DateTimeKind.Unspecified);
        
        var updatedReservation = new ReservationCreateRequest()
        {
            Title = ReservationDetail.Title,
            Description = ReservationDetail.Description,
            Capacity = ReservationDetail.Capacity,
            Start = TimeZoneInfo.ConvertTimeToUtc(startLocal, customTimeZone),
            End = TimeZoneInfo.ConvertTimeToUtc(endLocal, customTimeZone),
            IsAvailable = ReservationDetail.IsAvailable,
            CancellationOffset = TimeSpan.FromDays(CancellationOffsetDays) + (CancellationOffsetTime ?? TimeSpan.Zero),
            CustomTimeZoneId = ReservationDetail.CustomTimeZoneId
        };

        var response = await ReservationService.UpdateReservationAsync(updatedReservation, reservationId);
        if (response.IsSuccess)
        {
            Snackbar.Add("Změny byly úspěšně uloženy.", Severity.Success);
        }
        else
        {
            Snackbar.Add("Nepodařilo se uložit změny.", Severity.Error);
        }
    }

    private async Task CancelReservation()
    {
        // Zrušení rezervace
        var response = await ReservationService.DeleteReservationAsync(reservationId);
        if (response.IsSuccess)
        {
            Snackbar.Add("Rezervace byla zrušena.", Severity.Success);
            NavigationManager.NavigateTo(Constants.Routes.AccountRoute.AccountReservation);
        }
        else
        {
            Snackbar.Add("Nepodařilo se zrušit rezervaci.", Severity.Error);
        }
    }

    private async Task RemoveUser(UserResponse user)
    {
        // Odhlášení (odstranění) uživatele z rezervace
        var response = await ReservationService.RemoveUserFromReservationAsync(new RemoveUserFromReservationRequest()
        {
            UserEmail = user.Email,
            ReservationId = reservationId
        });
        if (response.IsSuccess)
        {
            Snackbar.Add($"Uživatel {user.Email} byl úspěšně odhlášen.", Severity.Success);
            ReservationDetail.Users.Remove(user);
        }
        else
        {
            Snackbar.Add("Nepodařilo se odhlásit uživatele.", Severity.Error);
        }
    }

}

@inject IReservationService ReservationService
@inject ISnackbar Snackbar

@page "/ucet/nova-rezervace"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<div class="w-100 h-100 m-auto" style="max-width: 400px">
    <EditForm Model="@NewReservation" OnValidSubmit="@OnSubmit">
        <DataAnnotationsValidator/>
        <ValidationSummary/>

        <MudTextField Label="Nadpis" @bind-Value="NewReservation.Title" Required="true"/>
        <MudTextField Label="Popis" @bind-Value="NewReservation.Description" Required="false"/>
        <MudNumericField T="int" Label="Kapacita" Min="0" @bind-Value="NewReservation.Capacity" Required="true"/>
        <MudText>Vyberte data</MudText>
        <MudDatePicker id="new-reservation" Date="@(null)" PickerVariant="PickerVariant.Static" 
                       AutoClose="false"
                       AdditionalDateClassesFunc="GetAdditionalDateClasses" DateChanged="ToggleDateSelection"
                       Label="Vyberte datum"/>
        <MudTimePicker Label="Start rezervace" @bind-Time="StartTime"/>
        <MudTimePicker Label="Konec rezervace" @bind-Time="EndTime"/>
        <MudSwitch Color="Color.Primary" Label="Dostupné" @bind-Value="NewReservation.IsAvailable"/>
        <MudText>Čas nemožnosti zrušení rezervace přihlášeným uživatelem</MudText>
        <MudStack Row="true">
                <MudNumericField T="int" Min="0"  Label="Dny" @bind-Value="CancellationOffsetDays"/>
                <MudTimePicker Label="24 hours" @bind-Time="CancellationOffsetTime"/>
            <MudTooltip Class="my-auto" ShowOnHover="true" Text="Nastavte si kolik dní a hodin bude moci před začátkem rezervace zrušeit přihlášený uživatel.">
                <MudIcon Icon="@Icons.Material.Filled.QuestionMark" Title="Tooltip" Size="Size.Small"
                         Color="Color.Primary"/>
            </MudTooltip>
        </MudStack>
        <MudSelect T="string" Label="UTC Offset (min)" @bind-Value="NewReservation.CustomTimeZoneId" Required="true">
            @foreach (var timezone in Constants.TimeZones)
            {
                <MudSelectItem Value="@(timezone.Id)">
                    @timezone.ToString()
                </MudSelectItem>
            }
        </MudSelect>

        <MudButton Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Submit" Class="mt-4">
            Vytvořit rezervace
        </MudButton>
    </EditForm>
</div>

@code {

    ReservationCreateRequest NewReservation { get; set; } = new ReservationCreateRequest()
    {
        IsAvailable = true
    };

    TimeSpan? StartTime { get; set; }
    TimeSpan? EndTime { get; set; }
    TimeSpan? CancellationOffsetTime { get; set; }
    int CancellationOffsetDays { get; set; } = 0;

    List<DateTime> SelectedDates { get; set; } = [];

    private int CancellationOffsetMinutes
    {
        get => (int)NewReservation.CancellationOffset.TotalMinutes;
        set => NewReservation.CancellationOffset = TimeSpan.FromMinutes(value);
    }

    protected override void OnInitialized()
    {
        var timeZone = TimeZoneInfo.Local;
        NewReservation.CustomTimeZoneId = Constants.TimeZones.First(x => x.Id == timeZone.Id).Id;
    }

    async Task OnSubmit()
    {
        // Nastavení CancellationOffset na základě dnů a času
        NewReservation.CancellationOffset = TimeSpan.FromDays(CancellationOffsetDays) + (CancellationOffsetTime ?? TimeSpan.Zero);

        if (SelectedDates.Count <= 0)
        {
            Snackbar.Add("Vyberte alespoň jedno datum.", Severity.Warning);
            return;
        }
        
        if (StartTime is null || EndTime is null)
        {
            Snackbar.Add("Vyberte čas začátku a konce rezervace.", Severity.Warning);
            return;
        }

        var reservations = new List<ReservationCreateRequest>();

        if (EndTime < StartTime)
        {
            EndTime = EndTime.Value.Add(TimeSpan.FromDays(1));
        }

        foreach (var date in SelectedDates)
        {
            var customTimeZone = TimeZoneInfo.FindSystemTimeZoneById(NewReservation.CustomTimeZoneId);
    
            var startLocal = date.Date.Add(StartTime.Value);
            var endLocal = date.Date.Add(EndTime.Value);
    
            if (endLocal <= startLocal)
            {
                endLocal = endLocal.AddDays(1);
            }

            reservations.Add(new ReservationCreateRequest()
            {
                Title = NewReservation.Title,
                Description = NewReservation.Description,
                Capacity = NewReservation.Capacity,
                Start = TimeZoneInfo.ConvertTimeToUtc(startLocal, customTimeZone),
                End = TimeZoneInfo.ConvertTimeToUtc(endLocal, customTimeZone),
                IsAvailable = NewReservation.IsAvailable,
                CustomTimeZoneId = NewReservation.CustomTimeZoneId,
                CancellationOffset = NewReservation.CancellationOffset
            });
        }

        var response = await ReservationService.CreateAsync(reservations);

        if (response.IsSuccess)
        {
            Snackbar.Add("Rezervace byly úspěšně vytvořeny.", Severity.Success);
        }
        else
        {
            Snackbar.Add("Nepodařilo se vytvořit rezervace.", Severity.Error);
        }
    }

    // Při kliknutí na den se dané datum přidá/odebere z výběru
    private void ToggleDateSelection(DateTime? date)
    {
        if (date == null)
        {
            return;
        }


        if (SelectedDates.Any(d => d.Date == date?.Date))
        {
            SelectedDates.RemoveAll(d => d.Date == date?.Date);
        }
        else
        {
            SelectedDates.Add((DateTime)date);
        }
    }

    private string GetAdditionalDateClasses(DateTime date)
    {
        if (SelectedDates.Any(d => d.Date == date.Date))
        {
            return "selected-date";
        }

        return string.Empty;
    }

}

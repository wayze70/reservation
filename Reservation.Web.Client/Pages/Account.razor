@inject NavigationManager NavigationManager
@inject IAccountService AccountService
@using Microsoft.AspNetCore.Authorization
@using Reservation.Shared.Common
@inject ISnackbar Snackbar

@page "/ucet"
@attribute [Authorize]

<PageTitle>Účet</PageTitle>
<MudPaper Class="pa-6 mx-auto my-6" MaxWidth="MaxWidth.Small" Elevation="4">
    <MudText Typo="Typo.h5" Align="Align.Center" GutterBottom="true">
        Nastavení URL cesty
    </MudText>

    @if (string.IsNullOrWhiteSpace(CurrentPath))
    {
        <MudText>
            Nastavte si URL cestu pro vaši rezervaci.
        </MudText>
    }
    else
    {
        <MudText>
            Aktuální URL cesta:
            <MudLink Href="@Constants.Routes.Reservation(CurrentPath)">
                @(NavigationManager.BaseUri)@Constants.Routes.Reservation(CurrentPath).Remove(0, 1)
            </MudLink>
        </MudText>
    }

    <MudStack Spacing="2" Class="mt-4">
        <MudTextField T="string" Value="Path" ValueChanged="OnPathChange" Label="Nastavte si URL" DebounceInterval="500" />
        <MudStack Row="false" AlignItems="AlignItems.Center" Spacing="1">
            @if ((IsPathTaken && CurrentPath != Path) || !IsPathValid)
            {
                <MudIcon Icon="@Icons.Material.Filled.Close" Color="Color.Error" Size="Size.Small" />
            }
            else
            {
                <MudIcon Icon="@Icons.Material.Filled.CheckCircleOutline" Color="Color.Success" Size="Size.Small" />
            }
            @if (IsPathTaken && CurrentPath == Path)
            {
                <MudText Color="Color.Info">Tato URL je vaše URL</MudText>
            }
            else if (IsPathTaken)
            {
                <MudText Color="Color.Error">Tato URL cesta je již zabraná</MudText>
            }
            else if (!IsPathValid)
            {
                <MudText Color="Color.Error">URL cesta obsahuje nepovolené znaky</MudText>
            }
        </MudStack>
        <MudButton OnClick="UpdatePath" Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Button" FullWidth="true">
            Aktualizovat URL cestu
        </MudButton>
    </MudStack>
</MudPaper>

@code
{
    string Path { get; set; } = "Načítám...";
    string CurrentPath { get; set; } = string.Empty;
    bool IsPathTaken { get; set; }
    bool IsPathValid { get; set; } = true;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        CurrentPath = (await AccountService.GetPath()).Data ?? string.Empty;
        Path = CurrentPath;
    }

    private async Task UpdatePath()
    {
        if (Utils.IsPathValidate(Path))
        {
            IsPathValid = true;
        }
        else
        {
            IsPathValid = false;
            return;
        }
        
        var response = await AccountService.UpdatePath(new PathRequest() { Path = Path });

        if (response is { IsSuccess: true, Data: not null })
        {
            CurrentPath = response.Data;
            
            Snackbar.Add("URL cesta byla úspěšně aktualizována.", Severity.Success);
        }
    }

    private async Task OnPathChange(string newPath)
    {
        Path = newPath;

        if (string.IsNullOrWhiteSpace(Path))
        {
            return;
        }

        if (Utils.IsPathValidate(Path))
        {
            IsPathValid = true;
            IsPathTaken = (await AccountService.IsPathTaken(new PathRequest() { Path = Path })).Data;
        }
        else
        {
            IsPathValid = false;
        }
    }
}
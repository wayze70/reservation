@page "/ucet/zamestnanci"
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using Reservation.Shared.Authorization
@inject IEmployeeService EmployeeService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<PageTitle>Správa zaměstnanců</PageTitle>
@attribute [Authorize]

<!-- Formulář pro přidání/úpravu zaměstnance -->
<MudPaper Class="pa-6 mb-6" Elevation="4">
  <MudText Typo="Typo.h4" Align="Align.Center" GutterBottom="true">
    Detaily zaměstnance
  </MudText>
  <EditForm Model="@SelectedEmployee" OnValidSubmit="@SaveChanges">
    <DataAnnotationsValidator />
    <MudGrid>
      <MudItem xs="12" sm="6">
        <MudTextField T="string" Label="Jméno" @bind-Value="SelectedEmployee.FirstName" Required="true" />
      </MudItem>
      <MudItem xs="12" sm="6">
        <MudTextField T="string" Label="Příjmení" @bind-Value="SelectedEmployee.LastName" Required="true" />
      </MudItem>
      <MudItem xs="12" sm="6">
        <MudTextField T="string" Label="Email" @bind-Value="SelectedEmployee.Email" Required="true" />
      </MudItem>
      <MudItem xs="12" sm="6">
        <MudSelect T="Role" Label="Pozice" @bind-Value="SelectedEmployee.Role" Required="true">
          @foreach (Role role in Enum.GetValues(typeof(Role)))
          {
            <MudSelectItem Value="@role">@role.ToString()</MudSelectItem>
          }
        </MudSelect>
      </MudItem>
    </MudGrid>
    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" FullWidth="true">
      Uložit změny
    </MudButton>
  </EditForm>
</MudPaper>

<!-- Seznam zaměstnanců -->
<MudPaper Class="pa-6" Elevation="4">
  <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
    <MudText Typo="Typo.h5" GutterBottom="true">
      Seznam zaměstnanců
    </MudText>
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="@CreateNewEmployee">
      Nový zaměstnanec
    </MudButton>
  </MudStack>

  @if (Employees is null)
  {
    <MudText>Načítám zaměstnance...</MudText>
  }
  else if (Employees.Count == 0)
  {
    <MudText>Nejsou žádní zaměstnanci.</MudText>
  }
  else
  {
    <MudTable Items="Employees">
      <HeaderContent>
        <MudTh>Jméno</MudTh>
        <MudTh>Příjmení</MudTh>
        <MudTh>Email</MudTh>
        <MudTh>Pozice</MudTh>
        <MudTh></MudTh>
      </HeaderContent>
      <RowTemplate>
        <MudTd DataLabel="Jméno">@context.FirstName</MudTd>
        <MudTd DataLabel="Příjmení">@context.LastName</MudTd>
        <MudTd DataLabel="Email">@context.Email</MudTd>
        <MudTd DataLabel="Pozice">@context.Role</MudTd>
        <MudTd DataLabel="Akce">
          <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="@(() => EditEmployee(@context))">
            Upravit
          </MudButton>
          <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" OnClick="@(() => RemoveEmployee(@context))">
            Smazat
          </MudButton>
        </MudTd>
      </RowTemplate>
    </MudTable>
  }
</MudPaper>

@code {
  // Seznam zaměstnanců
  private List<EmployeeResponse> Employees;

  // Model pro aktuálně vybíraného či nového zaměstnance
  // Předpokládáme, že EmployeeResponse má vlastnost Id, která je 0 u nového záznamu.
  private EmployeeResponse SelectedEmployee = new EmployeeResponse();

  protected override async Task OnInitializedAsync()
  {
    await LoadEmployees();
  }

  /// <summary>
  /// Načte seznam všech zaměstnanců.
  /// </summary>
  private async Task LoadEmployees()
  {
    var response = await EmployeeService.GetEmployees();
    if (response is { IsSuccess: true, Data: not null })
    {
      Employees = response.Data;
    }
    else
    {
      Snackbar.Add("Nepodařilo se načíst zaměstnance.", Severity.Error);
    }
  }

  /// <summary>
  /// Uloží změny pro aktuálně vybraného nebo nového zaměstnance.
  /// </summary>
  private async Task SaveChanges()
  {
    if (SelectedEmployee.Id == 0)
    {
      // Vytvoření nového zaměstnance
      var request = new EmployeeCreateRequest
      {
        FirstName = SelectedEmployee.FirstName,
        LastName = SelectedEmployee.LastName,
        Email = SelectedEmployee.Email,
        Role = SelectedEmployee.Role
      };

      var response = await EmployeeService.CreateEmployee(request);
      if (response.IsSuccess)
      {
        Snackbar.Add("Zaměstnanec byl úspěšně přidán.", Severity.Success);
        await LoadEmployees();
        SelectedEmployee = new EmployeeResponse();
      }
      else
      {
        Snackbar.Add("Nepodařilo se přidat zaměstnance.", Severity.Error);
      }
    }
    else
    {
      // Aktualizace existujícího zaměstnance
      var request = new EmployeeUpdateRequest
      {
        FirstName = SelectedEmployee.FirstName,
        LastName = SelectedEmployee.LastName,
        Email = SelectedEmployee.Email,
        Role = SelectedEmployee.Role
      };

      var response = await EmployeeService.UpdateEmployee(SelectedEmployee.Id, request);
      if (response.IsSuccess)
      {
        Snackbar.Add("Zaměstnanec byl úspěšně aktualizován.", Severity.Success);
        await LoadEmployees();
        SelectedEmployee = new EmployeeResponse();
      }
      else
      {
        Snackbar.Add("Nepodařilo se aktualizovat údaje zaměstnance.", Severity.Error);
      }
    }
  }

  /// <summary>
  /// Připraví formulář pro vložení nového zaměstnance.
  /// </summary>
  private void CreateNewEmployee()
  {
    SelectedEmployee = new EmployeeResponse();
  }

  /// <summary>
  /// Na základě vybraného zaměstnance připraví formulář pro úpravu.
  /// </summary>
  /// <param name="employee">Vybraný zaměstnanec</param>
  private void EditEmployee(EmployeeResponse employee)
  {
    // Pro jednoduchost vytváříme kopii vybraného zaměstnance
    SelectedEmployee = new EmployeeResponse
    {
      Id = employee.Id,
      FirstName = employee.FirstName,
      LastName = employee.LastName,
      Email = employee.Email,
      Role = employee.Role
    };
  }

  /// <summary>
  /// Odstraní záznam o zaměstnanci.
  /// </summary>
  /// <param name="employee">Zaměstnanec, kterého chceme smazat</param>
  private async Task RemoveEmployee(EmployeeResponse employee)
  {
    var response = await EmployeeService.DeleteEmployee(employee.Id);
    if (response.IsSuccess)
    {
      Snackbar.Add("Zaměstnanec byl smazán.", Severity.Success);
      await LoadEmployees();
    }
    else
    {
      Snackbar.Add("Nepodařilo se smazat zaměstnance.", Severity.Error);
    }
  }
}

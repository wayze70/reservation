@page "/rezervace/{Path}"
@inject IReservationService ReservationService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<PageTitle>Rezervace</PageTitle>

<!-- Datumový filtr -->
<MudDatePicker PickerVariant="PickerVariant.Static" @bind-Date="SelectedDate" Label="Vyberte datum"/>


@if (Reservations is null)
{
    <MudText>Načítám rezervace...</MudText>
}
else if (Reservations.Count == 0)
{
    <MudText>Nebyly nalezeny žádné rezervace pro firmu: @Path</MudText>
}
else
{
    <MudGrid>
        @foreach (var reservation in Reservations)
        {
            if (!reservation.IsAvailable || reservation.CurrentCapacity >= reservation.Capacity) continue;

            if (SelectedDate.HasValue && SelectedDate.Value.Date == reservation.Start.Date)
            {
                <MudItem xs="12" sm="6" md="4">
                    <MudCard Class="m-2">
                        <MudCardContent>
                            <MudText Typo="Typo.h6">@reservation.Title</MudText>
                            <MudText>Od: @reservation.Start.ToShortTimeString()</MudText>
                            <MudText>Do: @reservation.End.ToShortTimeString()</MudText>
                            <MudText>Kapacita: @reservation.CurrentCapacity / @reservation.Capacity</MudText>
                        </MudCardContent>
                        <MudCardActions>
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                       OnClick='() => NavigationManager.NavigateTo($"/rezervace/{Path}/{reservation.Id}")'>
                                Více informací
                            </MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        }
    </MudGrid>
}

@code {

    [Parameter]
    public string Path { get; set; } = string.Empty;

    DateTime? SelectedDate { get; set; } = DateTime.Today;
    List<ReservationResponse>? Reservations { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var response = await ReservationService.GetReservationsAsync(Path);
        if (response.IsSuccess)
        {
            Reservations = response.Data ?? new List<ReservationResponse>();
        }
        else
        {
            Snackbar.Add("Nesprávná URL adresa rezervací.", Severity.Error);
        }
    }

}

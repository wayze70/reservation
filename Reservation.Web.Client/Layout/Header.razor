@inject NavigationManager NavigationManager

<header class="bg-dark p-3">
    <div class="container d-flex justify-content-between">
        <h1 class="my-auto"><a class="text-white" href="@Constants.Routes.Home">Rezervační systém</a></h1>
        @if (!IsReservationRoute)
        {
            <Navigation />
        }
    </div>
</header>

@code
{
    bool IsReservationRoute => NavigationManager
        .ToBaseRelativePath(NavigationManager.Uri)
        .StartsWith("rezervace", StringComparison.OrdinalIgnoreCase);
    
    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}

@page "/rezervace/{Path}/{Id:int}"
@inject IReservationService ReservationService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<PageTitle>Detail rezervace</PageTitle>

    @if (ReservationDetail is null)
    {
        <MudText>Načítám rezervaci...</MudText>
    }
    else
    {
        bool IsSameTimeZone = (ReservationDetail.CustomTimeZoneId != GlobalState.CurrentTimeZone.Id);
        
        <MudCard>
            <MudCardActions>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="Back">
                    Zpět na rezervace
                </MudButton>
            </MudCardActions>
            <MudCardHeader>
                <MudText Typo="Typo.h5">@ReservationDetail.Title</MudText>
            </MudCardHeader>
            <MudCardContent>
                <MudText>Popis: @ReservationDetail.Description</MudText>
                <MudText>
                    Od: @ReservationDetail.Start.ConvertToTimeZone(ReservationDetail.CustomTimeZoneId).ToString("g")
                </MudText>
                @if (IsSameTimeZone)
                {
                    <MudText>
                        Ve vaší časové pásmu od: @ReservationDetail.Start.ConvertToTimeZone(GlobalState.CurrentTimeZone).ToString("g")
                    </MudText>
                }
                <MudText>Do: @ReservationDetail.End.ConvertToTimeZone(ReservationDetail.CustomTimeZoneId).ToString("g")</MudText>
                @if (IsSameTimeZone)
                {
                    <MudText>
                        Ve vaší časové pásmu od: @ReservationDetail.End.ConvertToTimeZone(GlobalState.CurrentTimeZone).ToString("g")
                    </MudText>
                }
                <MudText>Kapacita: @ReservationDetail.CurrentCapacity / @ReservationDetail.Capacity</MudText>
                <MudText Color="@(ReservationDetail.IsAvailable ? Color.Success : Color.Error)">
                    @(ReservationDetail.IsAvailable ? "Dostupná" : "Nedostupná")
                </MudText>
                <MudDivider Class="my-2"/>
                <MudText>Možnost zrušení před zahájením: @ReservationDetail.CancellationOffset.ToString()</MudText>
            </MudCardContent>
            <MudCardActions>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SignUp">
                    Přihlásit se na rezervaci
                </MudButton>
            </MudCardActions>

        </MudCard>
    }

@code {

    [Parameter]
    public string Path { get; set; } = string.Empty;

    [Parameter]
    public int Id { get; set; }

    ReservationResponse? ReservationDetail { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var response = await ReservationService.GetReservationAsync(Path, Id);
        if (response is { IsSuccess: true, Data: not null })
        {
            ReservationDetail = response.Data;
        }
        else
        {
            Snackbar.Add("Nepodařilo se načíst detail rezervace.", Severity.Error);
        }
    }

    private void Back()
    {
        NavigationManager.NavigateTo(Constants.Routes.Reservation(Path));
    }

    private void SignUp()
    {
        NavigationManager.NavigateTo(Constants.Routes.ReservationSignUp(Path, Id));
    }

}

@page "/rezervace/{Path}/{ReservationId:int}/prihlaseni"
@using System.Net
@using Reservation.Web.Client.Components
@inject IReservationService ReservationService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<PageTitle>Přihlášení k rezervaci</PageTitle>

<MudCard Class="mx-auto mt-12" Style="max-width:480px;" Elevation="4">
    <MudButton Class="m-2" Style="width: fit-content" Variant="Variant.Outlined" Color="Color.Primary" OnClick="Back"
               StartIcon="@Icons.Material.Filled.ArrowBack">
        Zpět
    </MudButton>
    <!-- HEADER -->
    <MudCardHeader>
        <MudText Typo="Typo.h5">Přihlášení k rezervaci</MudText>

    </MudCardHeader>
    <MudDivider/>

    <!-- FORMULÁŘ -->
    <EditForm Model="@SignUpRequest" OnValidSubmit="OnSubmit">
        <DataAnnotationsValidator/>
        <MudCardContent>
            <ValidationSummary Class="mb-4"/>

            <MudGrid GutterSize="3">
                <MudItem xs="12" sm="6">
                    <MudTextField T="string"
                                  Label="Jméno"
                                  @bind-Value="SignUpRequest.FirstName"
                                  Required="true"
                                  Variant="Variant.Outlined"
                                  FullWidth="true"
                                  Adornment="Adornment.Start"/>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField T="string"
                                  Label="Příjmení"
                                  @bind-Value="SignUpRequest.LastName"
                                  Required="true"
                                  Variant="Variant.Outlined"
                                  FullWidth="true"
                                  Adornment="Adornment.Start"/>
                </MudItem>

                <MudItem xs="12">
                    <EmailInput
                        @bind-Value="SignUpRequest.Email"
                        Required="true"
                        Variant="Variant.Outlined"
                        FullWidth="true"
                        Adornment="Adornment.Start"
                        AdornmentIcon="@Icons.Material.Filled.Email"/>
                </MudItem>

                <MudItem xs="12">
                    <MudTextField T="string"
                                  Label="Poznámka"
                                  @bind-Value="SignUpRequest.Note"
                                  Variant="Variant.Outlined"
                                  FullWidth="true"
                                  Lines="3"
                                  AutoFocus="true"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.EditNote"/>
                </MudItem>
            </MudGrid>
        </MudCardContent>

        <!-- ACTIONS -->
        <MudDivider/>
        <MudCardActions Class="justify-end">
            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       Class="px-6">
                Rezervovat
            </MudButton>
        </MudCardActions>
    </EditForm>
</MudCard>

@code {

    // Parametr z URL, který určuje, ke které rezervaci se uživatel přihlašuje
    [Parameter]
    public int ReservationId { get; set; }

    [Parameter, EditorRequired]
    public string Path { get; set; } = string.Empty;

    // Model pro přihlášení k rezervaci
    ReservationSignUpRequest SignUpRequest { get; set; } = new ReservationSignUpRequest();

    private async Task OnSubmit()
    {
        // Předpokládáme, že metoda SignUpForReservationAsync vrací ApiResponse<string> s potvrzením nebo chybovou zprávou
        var response = await ReservationService.SignInToReservation(ReservationId, SignUpRequest);

        if (response.IsSuccess)
        {
            Snackbar.Add("Úspěšně jste se přihlásili k rezervaci", Severity.Success);
            // Přesměrování na detail rezervace nebo jinou stránku
            NavigationManager.NavigateTo(Constants.Routes.ReservationDetail(Path, ReservationId));
        }
        else if (response.StatusCode == HttpStatusCode.BadRequest)
        {
            Snackbar.Add("Omlouváme se, ale rezervace je již plná", Severity.Warning);
        }
        else if (response.StatusCode == HttpStatusCode.Conflict)
        {
            Snackbar.Add("Uživatel je již přihlášen na této rezervaci", Severity.Warning);
        }
        else
        {
            Snackbar.Add($"Chyba při přihlašování", Severity.Error);
        }
    }

    private void Back()
    {
        NavigationManager.NavigateTo(Constants.Routes.ReservationDetail(Path, ReservationId));
    }

}
